# ---------------------------------------------------------------------------
# Banco de dados (obrigatório)
# Local: o docker-compose.yml sobe um Postgres na porta 5434.
# Railway: use a variável do plugin Postgres (${{ Postgres.DATABASE_URL }}).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://trajetoria:trajetoria@localhost:5434/trajetoria"

# ---------------------------------------------------------------------------
# Autenticação (obrigatório) — mínimo 16 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------
AUTH_SECRET=""

# Necessário atrás de proxy (Railway, Docker). Mantenha true em produção.
AUTH_TRUST_HOST=true

# ---------------------------------------------------------------------------
# URLs da aplicação — usadas em QR Code, links de certificado e reset de senha.
# Em produção use o domínio público, com https e sem barra no fim.
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Storage de uploads: local | s3
# local  -> grava em ./.uploads e serve por /api/files/... (apenas desenvolvimento:
#           o disco do Railway é efêmero e os arquivos somem a cada deploy).
# s3     -> qualquer storage S3-compatible (Cloudflare R2, AWS S3, MinIO).
# ---------------------------------------------------------------------------
STORAGE_PROVIDER="local"

# Preencha apenas quando STORAGE_PROVIDER=s3.
# Exemplo Cloudflare R2:
#   S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
#   S3_REGION="auto"
#   S3_BUCKET="trajetoria"
#   S3_PUBLIC_URL="https://arquivos.suaescola.com.br"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ---------------------------------------------------------------------------
# Banco usado pelos testes de integração (npm run test:db).
# Precisa ser um banco separado — o conteúdo é apagado a cada execução.
# ---------------------------------------------------------------------------
# TEST_DATABASE_URL="postgresql://trajetoria:trajetoria@localhost:5434/trajetoria_test"
